# EVIDA environment variables. Copy to .env for local development.
# Never commit real secrets. In staging/production, inject these from a secrets manager.
# Full reference: docs/ENVIRONMENT.md

# ---------- Core ----------
NODE_ENV=development
# These are the container-internal ports. docker-compose.yml maps them to custom host ports
# (api -> 14000, web -> 13000) so EVIDA can run side by side with other local projects.
API_PORT=4000
WORKER_PORT=4100
WEB_ORIGIN=http://localhost:13000
LOG_LEVEL=info
DEFAULT_TZ=Africa/Cairo
EXPOSE_OPENAPI=false

# ---------- Database / Cache ----------
# Host-side port is remapped to 15432 (docker-compose.yml) to run side by side with other local
# projects; containers still talk to each other over the internal docker network on 5432.
DATABASE_URL=postgresql://evida:evida@localhost:15432/evida?schema=public
DB_POOL_MAX=10
REDIS_URL=redis://localhost:16379

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
COOKIE_SECURE=false

# ---------- AI (Anthropic Claude) ----------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Reasoning tier: competency frameworks, interview plans, score suggestions, decision summaries
AI_MODEL_REASONING=claude-sonnet-5
# Fast tier: CV analysis, evidence extraction, live copilot
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_PROCESSING_LOCATION=anthropic-us
# USD per million tokens, used for cost tracking. Check current Anthropic pricing.
AI_PRICE_REASONING_IN=3
AI_PRICE_REASONING_OUT=15
AI_PRICE_FAST_IN=1
AI_PRICE_FAST_OUT=5
FEATURE_LIVE_COPILOT=true

# ---------- Jitsi ----------
JITSI_DOMAIN=localhost:18443
JITSI_APP_ID=evida
JITSI_APP_SECRET=change-me-jitsi-secret
JITSI_TOKEN_TTL=7200
# HMAC secret for inbound events from the Jitsi transcriber relay / Jibri finalize script
JITSI_WEBHOOK_SECRET=change-me-jitsi-webhook

# ---------- Object Storage (S3 / MinIO) ----------
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=evida
S3_ACCESS_KEY=evida
S3_SECRET_KEY=evidaevida
MAX_UPLOAD_MB=10
# ClamAV daemon for upload scanning (required in production)
CLAMAV_HOST=
CLAMAV_PORT=13310

# ---------- Email ----------
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EVIDA <no-reply@evida.local>"

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---------- Web (Next.js) ----------
API_INTERNAL_URL=http://localhost:14000
NEXT_PUBLIC_JITSI_DOMAIN=localhost:18443
# Opt-in browser speech recognition for live captions (browsers may use a vendor speech service)
NEXT_PUBLIC_BROWSER_CAPTIONS=false

# ---------- Seed (demo environment only) ----------
SEED_PASSWORD=
